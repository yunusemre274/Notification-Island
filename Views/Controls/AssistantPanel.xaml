<UserControl x:Class="NI.Views.Controls.AssistantPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource GlassCard}"><StackPanel>
   <TextBlock Text="Yerel masaüstü ajanı" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="Yerel model • Doğrulanmış araçlar • Görev kapsamlı yetki" Style="{StaticResource Caption}" Margin="0,5,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding AssistantInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.Name="Yerel ajana görev ver" ToolTip="Örnek: Masaüstümü düzenle; belgeleri, görselleri ve arşivleri ayır." MinHeight="34" VerticalContentAlignment="Center"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AskCommand}"/></TextBox.InputBindings></TextBox>
    <Button Grid.Column="2" Command="{Binding AskCommand}" Content="Çalıştır" IsEnabled="{Binding AssistantEnabled}"/>
   </Grid>
   <TextBlock Text="{Binding TaskDetails}" Style="{StaticResource Caption}" Margin="0,10,0,5"/>
   <TextBlock Text="{Binding AssistantResponse}" TextWrapping="Wrap" LineHeight="19" MaxHeight="100"/>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Command="{Binding CancelTaskCommand}" Content="İptal" IsEnabled="{Binding IsAssistantBusy}" Margin="0,0,8,0"/><Button Command="{Binding UndoTaskCommand}" Content="Son düzenlemeyi geri al" Margin="0,0,8,0"/><Button Content="Ayrıntılar" Command="{Binding OperationDetailsCommand}"/></StackPanel>
   <TextBox Text="{Binding OperationDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
   <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0" Visibility="{Binding HasApproval, Converter={StaticResource BoolVisibility}}"><StackPanel>
    <TextBlock Text="İşlem onayı" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding ApprovalText}" TextWrapping="Wrap" Margin="0,6,0,8"/>
    <StackPanel Orientation="Horizontal"><Button Command="{Binding ApproveTaskCommand}" Content="Bu planı onayla" Margin="0,0,8,0"/><Button Command="{Binding RejectTaskCommand}" Content="Reddet"/></StackPanel>
   </StackPanel></Border>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassCard}" Margin="0,10,0,0"><StackPanel>
   <TextBlock Text="Alarmlar ve hatırlatıcılar" FontSize="15" FontWeight="SemiBold"/>
   <TextBlock Text="Model olmadan da kullanılabilir. Örnek: Yarın sabah 08.30'a alarm kur." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding AlarmInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Alarm zamanı"/><Button Grid.Column="2" Content="Alarm kur" Command="{Binding CreateAlarmCommand}"/></Grid>
   <ItemsControl ItemsSource="{Binding Alarms}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel ToolTip="{Binding Delivery}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding NextDue, StringFormat=yyyy-MM-dd HH:mm zzz}"/><Run Text=" • "/><Run Text="{Binding Repeat}"/><Run Text=" • "/><Run Text="{Binding State}"/></TextBlock></StackPanel><Button Grid.Column="1" Command="{Binding DataContext.CancelAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="İptal" Padding="8,3"/></Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
