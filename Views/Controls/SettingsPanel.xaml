<UserControl x:Class="NI.Views.Controls.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel><TextBlock Text="Tam senin gibi." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Görünüm ve davranış değişiklikleri otomatik kaydedilir." Style="{StaticResource Caption}" Margin="0,5,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="COMPACT BAR" Style="{StaticResource SectionTitle}" Margin="0,10,0,7"/><CheckBox Content="Saat" IsChecked="{Binding Appearance.ShowClock}"/><CheckBox Content="Hava durumu" IsChecked="{Binding Appearance.ShowWeather}"/><CheckBox Content="Medya özeti" IsChecked="{Binding Appearance.ShowMediaSummary}"/><CheckBox Content="Bildirim önizlemesi" IsChecked="{Binding Appearance.ShowNotificationSummary}"/><TextBlock Text="EXPANDED PANEL" Style="{StaticResource SectionTitle}" Margin="0,10,0,7"/><CheckBox Content="Bildirimler" IsChecked="{Binding Appearance.ShowNotifications}"/><CheckBox Content="Sistem durumu" IsChecked="{Binding Appearance.ShowSystemStatus}"/><CheckBox Content="Medya" IsChecked="{Binding Appearance.ShowMedia}"/><CheckBox Content="Bağlantılar" IsChecked="{Binding Appearance.ShowConnections}"/><TextBlock Text="DAVRANIŞ" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
<CheckBox Content="Her zaman üstte" IsChecked="{Binding Appearance.AlwaysOnTop}"/>
<CheckBox Content="Hover ile genişlet" IsChecked="{Binding Appearance.ExpandOnHover}"/>
<CheckBox Content="İmleç ayrılınca otomatik daralt" IsChecked="{Binding Appearance.AutoCollapse}"/>
<CheckBox Content="Hareketi azalt" IsChecked="{Binding Appearance.ReduceMotion}"/>
<TextBlock Text="HAVA DURUMU" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
<TextBlock Text="Enlem / boylam • Open-Meteo" Style="{StaticResource Caption}"/>
<UniformGrid Columns="2" Margin="0,6,0,3"><TextBox Text="{Binding WeatherLatitude, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" AutomationProperties.Name="Hava durumu enlem" ToolTip="Enlem, ör. 41.01"/><TextBox Text="{Binding WeatherLongitude, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" AutomationProperties.Name="Hava durumu boylam" ToolTip="Boylam, ör. 28.97"/></UniformGrid>
<TextBlock Text="Etkinleştirildiğinde koordinatlar Open-Meteo’ya gönderilir. Otomatik konum kullanılmaz." Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap"/>
<TextBlock Text="YEREL ASİSTAN" Style="{StaticResource SectionTitle}" Margin="0,14,0,7"/>
<TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ollama sunucu adresi" Margin="0,0,0,6"/>
<TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ollama model adı"/>
<TextBlock Text="Model tur sınırı / görev süresi (sn)" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
<UniformGrid Columns="2"><TextBox Text="{Binding AgentMaxTurns, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" AutomationProperties.Name="Ajan model tur sınırı"/><TextBox Text="{Binding AgentTaskSeconds, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" AutomationProperties.Name="Ajan görev süre sınırı"/></UniformGrid>
<TextBlock Text="Alarm saat dilimi kimliği" Style="{StaticResource Caption}" Margin="0,8,0,4"/><TextBox Text="{Binding AlarmTimeZone, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Alarm saat dilimi"/>
</StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CAM GÖRÜNÜMÜ" Style="{StaticResource SectionTitle}" Margin="0,10,0,7"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Tema" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Appearance.Theme}" AutomationProperties.Name="Cam teması"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Materyal / blur" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding Appearance.Material}" AutomationProperties.Name="Cam materyali"/></StackPanel></Grid>
<TextBlock Text="{Binding MaterialStatus}" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,10"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Yüzey opaklığı" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.SurfaceOpacity, StringFormat=P0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.SurfaceOpacity, Mode=TwoWay}" Minimum=".45" Maximum="1" AutomationProperties.Name="Yüzey opaklığı"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Köşe yarıçapı" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.CornerRadius, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.CornerRadius, Mode=TwoWay}" Minimum="8" Maximum="32" AutomationProperties.Name="Köşe yarıçapı"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Compact genişlik" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.CompactWidth, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.CompactWidth, Mode=TwoWay}" Minimum="360" Maximum="640" AutomationProperties.Name="Compact genişlik"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Panel genişliği" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.PanelWidth, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.PanelWidth, Mode=TwoWay}" Minimum="680" Maximum="1000" AutomationProperties.Name="Panel genişliği"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Compact yükseklik" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.CompactHeight, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.CompactHeight, Mode=TwoWay}" Minimum="42" Maximum="64" AutomationProperties.Name="Compact yükseklik"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Expanded maksimum yükseklik" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.ExpandedMaxHeight, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.ExpandedMaxHeight, Mode=TwoWay}" Minimum="300" Maximum="720" AutomationProperties.Name="Expanded maksimum yükseklik"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Yatay konum farkı" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.HorizontalOffset, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.HorizontalOffset, Mode=TwoWay}" Minimum="-1000" Maximum="1000" AutomationProperties.Name="Yatay konum farkı"/>
<Grid Margin="0,6,0,0"><TextBlock Text="Üst boşluk" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Appearance.TopOffset, StringFormat=0}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
<Slider Value="{Binding Appearance.TopOffset, Mode=TwoWay}" Minimum="0" Maximum="160" AutomationProperties.Name="Üst boşluk"/>
<TextBlock Text="Windows blur yarıçapını uygulamalara açmaz. None, Mica ve Acrylic sistemin sunduğu materyal seçenekleridir. Saydamlık sistem politikasına bağlıdır." TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="10" Margin="0,8,0,0"/>
<Button Content="Uygulamadan çık" Command="{Binding ExitCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
</StackPanel></Grid></StackPanel></UserControl>