<UserControl x:Class="NI.Views.Controls.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <TabControl>
  <TabItem Header="Görünüm">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Cam yüzey" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Tema" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
     <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Appearance.Theme}" AutomationProperties.Name="Cam teması"/>
     <TextBlock Text="Materyal" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
     <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding Appearance.Material}" AutomationProperties.Name="Cam materyali"/>
     <TextBlock Text="Yüzey opaklığı" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
     <Slider Value="{Binding Appearance.SurfaceOpacity, Mode=TwoWay}" Minimum=".45" Maximum="1" AutomationProperties.Name="Yüzey opaklığı"/>
     <TextBlock Text="Panel köşeleri" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
     <Slider Value="{Binding Appearance.CornerRadius, Mode=TwoWay}" Minimum="8" Maximum="32" AutomationProperties.Name="Panel köşe yarıçapı"/>
     <CheckBox Content="Hareketi azalt" IsChecked="{Binding Appearance.ReduceMotion}" FontSize="11"/>
    </StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Masaüstüne uyumlu" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding MaterialStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <TextBlock Text="Acrylic arka planı sistem üzerinden bulanıklaştırır. Windows 10 ve desteklenmeyen sistemlerde okunabilir opak yüzey kullanılır." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
     <TextBlock Text="Kapsül köşeleri yüksekliğe göre otomatik hesaplanır. Değişiklikler otomatik kaydedilir." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="17"/>
     <Button Content="Uygulamadan çık" Command="{Binding ExitCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
    </StackPanel></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Düzen">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Görünür öğeler" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <CheckBox Content="Saat" IsChecked="{Binding Appearance.ShowClock}" FontSize="11"/>
     <CheckBox Content="Medya özeti" IsChecked="{Binding Appearance.ShowMediaSummary}" FontSize="11"/>
     <CheckBox Content="Bildirim önizlemesi" IsChecked="{Binding Appearance.ShowNotificationSummary}" FontSize="11"/>
     <CheckBox Content="Bildirimler" IsChecked="{Binding Appearance.ShowNotifications}" FontSize="11"/>
     <CheckBox Content="Bağlantılar" IsChecked="{Binding Appearance.ShowConnections}" FontSize="11"/>
     <CheckBox Content="Sistem durumu" IsChecked="{Binding Appearance.ShowSystemStatus}" FontSize="11"/>
     <CheckBox Content="Medya kartı" IsChecked="{Binding Appearance.ShowMedia}" FontSize="11"/>
     <CheckBox Content="Hava durumu" IsChecked="{Binding Appearance.ShowWeather}" FontSize="11"/>
    </StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Boyut ve konum" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Compact genişlik" Style="{StaticResource Caption}"/>
     <Slider Value="{Binding Appearance.CompactWidth, Mode=TwoWay}" Minimum="360" Maximum="640" AutomationProperties.Name="Compact genişlik"/>
     <TextBlock Text="Panel genişliği" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
     <Slider Value="{Binding Appearance.PanelWidth, Mode=TwoWay}" Minimum="680" Maximum="1000" AutomationProperties.Name="Panel genişliği"/>
     <TextBlock Text="Compact yükseklik" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
     <Slider Value="{Binding Appearance.CompactHeight, Mode=TwoWay}" Minimum="42" Maximum="64" AutomationProperties.Name="Compact yükseklik"/>
     <TextBlock Text="Yatay konum" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
     <Slider Value="{Binding Appearance.HorizontalOffset, Mode=TwoWay}" Minimum="-1000" Maximum="1000" AutomationProperties.Name="Yatay konum"/>
     <TextBlock Text="Üst boşluk" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
     <Slider Value="{Binding Appearance.TopOffset, Mode=TwoWay}" Minimum="0" Maximum="160" AutomationProperties.Name="Üst boşluk"/>
    </StackPanel></Border>
    <Border Grid.Column="4" Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Davranış" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <CheckBox Content="Her zaman üstte" IsChecked="{Binding Appearance.AlwaysOnTop}" FontSize="11"/>
     <CheckBox Content="Hover ile aç" IsChecked="{Binding Appearance.ExpandOnHover}" FontSize="11"/>
     <TextBlock Text="Panel yalnızca ok, Escape veya bir bildirimi açtığında kapanır. İmleç ayrılması ve odak kaybı paneli kapatmaz." FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,9,0,12"/>
     <TextBlock Text="Hava durumu konumu" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBox Text="{Binding WeatherLatitude, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hava durumu enlem" ToolTip="Enlem. Koordinatlar yalnızca hava durumu açıkken Open-Meteo'ya gönderilir." Margin="0,0,0,5"/>
     <TextBox Text="{Binding WeatherLongitude, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hava durumu boylam" ToolTip="Boylam. Otomatik konum sorgusu yapılmaz."/>
    </StackPanel></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Asistan">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Yerel model bağlantısı" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Ollama adresi" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
     <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ollama adresi"/>
     <TextBlock Text="Kurulu model adı" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
     <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Ollama modeli"/>
     <TextBlock Text="Araç çağırmayı destekleyen yerel model kullan. Model otomatik indirilmez." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
     <Button Content="Compact barda görev yaz" Command="{Binding ToggleAssistantCommand}" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Görev sınırları" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Model tur sınırı" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
     <TextBox Text="{Binding AgentMaxTurns, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Model tur sınırı"/>
     <TextBlock Text="Görev süresi (saniye)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
     <TextBox Text="{Binding AgentTaskSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Görev süresi"/>
     <TextBlock Text="Enter görevi çalıştırır. Escape girişi kapatır. İşlem onayı ve geri alma kontrol merkezindeki küçük görev kartındadır." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="17"/>
    </StackPanel></Border>
   </Grid>
  </TabItem>
  <TabItem Header="Alarmlar">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassCard}"><StackPanel>
     <TextBlock Text="Yeni alarm" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Ollama olmadan çalışır. Örnek: Yarın sabah 08:30'a alarm kur." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBox Text="{Binding AlarmInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Alarm zamanı"/>
     <Button Content="Alarm kur" Command="{Binding CreateAlarmCommand}" Margin="0,8,0,12"/>
     <TextBlock Text="Saat dilimi kimliği" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
     <TextBox Text="{Binding AlarmTimeZone, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Alarm saat dilimi"/>
    </StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource GlassCard}"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Yaklaşan alarmlar" FontSize="13" FontWeight="SemiBold"/>
     <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleAlarms}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NextDue, StringFormat=dd.MM HH:mm}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
       <Button Grid.Column="1" Content="İptal" Command="{Binding DataContext.CancelAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="10" Padding="5,2" MinHeight="24"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding HasAlarmPages, Converter={StaticResource BoolVisibility}}">
      <Button Content="‹" Command="{Binding PreviousAlarmPageCommand}" Padding="7,2" MinHeight="24" AutomationProperties.Name="Önceki alarm sayfası"/>
      <TextBlock Text="{Binding AlarmPageLabel}" FontSize="10" Margin="10,0"/>
      <Button Content="›" Command="{Binding NextAlarmPageCommand}" Padding="7,2" MinHeight="24" AutomationProperties.Name="Sonraki alarm sayfası"/>
     </StackPanel>
    </Grid></Border>
   </Grid>
  </TabItem>
 </TabControl>
</UserControl>
