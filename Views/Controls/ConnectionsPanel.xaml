<UserControl x:Class="NI.Views.Controls.ConnectionsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NI.Controls">
    <Border Style="{StaticResource GlassCard}" Padding="10" DataContext="{Binding QuickControls}">
        <StackPanel>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Command="{Binding WifiCommand}" AutomationProperties.Name="Wi-Fi" ToolTip="Wi-Fi durumunu değiştir; erişilemiyorsa Windows ayarlarını aç">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickButton}"><Style.Triggers><DataTrigger Binding="{Binding WifiOn}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel><c:IslandIcon Kind="Wifi" Margin="0,0,0,4"/><TextBlock Text="Wi-Fi" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding WifiLabel}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding BluetoothCommand}" AutomationProperties.Name="Bluetooth" ToolTip="Bluetooth durumunu değiştir; erişilemiyorsa Windows ayarlarını aç">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickButton}"><Style.Triggers><DataTrigger Binding="{Binding BluetoothOn}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel><c:IslandIcon Kind="Bluetooth" Margin="0,0,0,4"/><TextBlock Text="Bluetooth" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding BluetoothLabel}" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Grid.Column="4" Command="{Binding AirplaneCommand}" Style="{StaticResource QuickButton}" ToolTip="Windows uçak modu ayarlarını aç" AutomationProperties.Name="Uçak modu ayarları">
                    <StackPanel><c:IslandIcon Kind="Airplane" Margin="0,0,0,4"/><TextBlock Text="Uçak modu" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="Ayarları aç" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                </Button>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                <Button Command="{Binding MuteCommand}" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" IsEnabled="{Binding AudioAvailable}" ToolTip="Sesi kapat veya aç" AutomationProperties.Name="Sesi kapat veya aç"><c:IslandIcon Kind="{Binding VolumeIcon}" FontSize="14"/></Button>
                <Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding AudioAvailable}" AutomationProperties.Name="Ses seviyesi"/>
                <Button Grid.Column="2" Command="{Binding SoundSettingsCommand}" BorderBrush="Transparent" Padding="0" MinHeight="24" ToolTip="Ses ayarlarını aç"><TextBlock Text="{Binding VolumeLabel}" Style="{StaticResource Caption}" FontSize="10"/></Button>
                <c:IslandIcon Grid.Row="1" Kind="Brightness" FontSize="14"/>
                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding BrightnessAvailable}" AutomationProperties.Name="Ekran parlaklığı" ToolTip="{Binding BrightnessLabel}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BrightnessLabel}" Style="{StaticResource Caption}" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding BrightnessLabel}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
