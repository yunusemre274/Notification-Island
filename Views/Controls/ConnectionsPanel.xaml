<UserControl x:Class="NI.Views.Controls.ConnectionsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NI.Controls" DataContext="{Binding QuickControls}">
 <Border Style="{StaticResource GlassCard}" Padding="9">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="5"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <c:ToggleTile Icon="Wifi" Title="Wi-Fi" Status="{Binding WifiLabel}" IsActive="{Binding WifiOn}" Command="{Binding WifiCommand}" AutomationProperties.Name="Wi-Fi" ToolTip="Wi-Fi durumunu değiştir; erişilemiyorsa Windows ayarlarını aç"/>
    <c:ToggleTile Grid.Column="2" Icon="Bluetooth" Title="Bluetooth" Status="{Binding BluetoothLabel}" IsActive="{Binding BluetoothOn}" Command="{Binding BluetoothCommand}" AutomationProperties.Name="Bluetooth" ToolTip="Bluetooth durumunu değiştir; erişilemiyorsa Windows ayarlarını aç"/>
    <c:ToggleTile Grid.Column="4" Icon="Airplane" Title="Uçak Modu" Status="Ayarlar" Command="{Binding AirplaneCommand}" AutomationProperties.Name="Uçak modu ayarları" ToolTip="Windows uçak modu ayarlarını aç. Uçak modu durumu bu API ile okunamıyor."/>
   </Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
    <Button Command="{Binding MuteCommand}" Style="{StaticResource IconButton}" Width="22" Height="20" MinHeight="20" IsEnabled="{Binding AudioAvailable}" AutomationProperties.Name="Sesi kapat veya aç"><c:IslandIcon Kind="{Binding VolumeIcon}" FontSize="14"/></Button>
    <Slider Grid.Column="1" Height="20" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding AudioAvailable}" AutomationProperties.Name="Ses seviyesi"/>
    <Button Grid.Column="2" Command="{Binding SoundSettingsCommand}" BorderThickness="0" Padding="0" MinHeight="20"><TextBlock Text="{Binding VolumeLabel}" FontSize="10" HorizontalAlignment="Right"/></Button>
    <c:IslandIcon Grid.Row="1" Kind="Brightness" FontSize="14"/>
    <Slider Grid.Row="1" Grid.Column="1" Height="20" Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding BrightnessAvailable}" AutomationProperties.Name="Ekran parlaklığı"/>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BrightnessLabel}" FontSize="9.5" HorizontalAlignment="Right"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
