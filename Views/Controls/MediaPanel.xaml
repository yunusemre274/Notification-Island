<UserControl x:Class="NI.Views.Controls.MediaPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NI.Controls">
 <Border Style="{StaticResource GlassCard}" Padding="10,8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource MediaChip}" Width="32" Height="32" Padding="3" VerticalAlignment="Center"><c:MediaSourceIcon Source="{Binding MediaSource}" ToolTip="{Binding MediaSourceName}"/></Border>
    <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding MediaTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaTitle}"/>
     <TextBlock Text="{Binding MediaArtist}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding HasMedia}" VerticalAlignment="Center">
     <Button Command="{Binding PreviousCommand}" Style="{StaticResource IconButton}" Width="24" Height="28" MinHeight="28" ToolTip="Önceki" AutomationProperties.Name="Önceki parça"><c:IslandIcon Kind="Previous" FontSize="11"/></Button>
     <Button Command="{Binding TogglePlaybackCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Background="{DynamicResource HoverBrush}" ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}"><c:IslandIcon Kind="{Binding PlayIcon}" FontSize="13"/></Button>
     <Button Command="{Binding NextCommand}" Style="{StaticResource IconButton}" Width="24" Height="28" MinHeight="28" ToolTip="Sonraki" AutomationProperties.Name="Sonraki parça"><c:IslandIcon Kind="Next" FontSize="11"/></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Visibility="{Binding HasMedia, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding MediaPosition}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
    <ProgressBar Grid.Column="1" Value="{Binding MediaProgress, Mode=OneWay}" Maximum="100" Margin="8,0" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="{Binding MediaDuration}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
