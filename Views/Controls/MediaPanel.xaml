<UserControl x:Class="NI.Views.Controls.MediaPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NI.Controls">
    <Border Style="{StaticResource GlassCard}" Padding="10">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource HoverBrush}" ClipToBounds="True"><Grid><c:IslandIcon Kind="Music" Foreground="{DynamicResource TextSecondary}"/><Border CornerRadius="10"><Border.Background><ImageBrush ImageSource="{Binding AlbumArtwork}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border>
                <StackPanel Grid.Column="1" Margin="9,0,5,0" VerticalAlignment="Center"><TextBlock Text="{Binding MediaTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaArtist}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding HasMedia}">
                    <Button Command="{Binding PreviousCommand}" Style="{StaticResource IconButton}" Width="25" ToolTip="Önceki" AutomationProperties.Name="Önceki parça"><c:IslandIcon Kind="Previous" FontSize="11"/></Button>
                    <Button Command="{Binding TogglePlaybackCommand}" Style="{StaticResource IconButton}" Background="{DynamicResource HoverBrush}" ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}"><c:IslandIcon Kind="{Binding PlayIcon}" FontSize="13"/></Button>
                    <Button Command="{Binding NextCommand}" Style="{StaticResource IconButton}" Width="25" ToolTip="Sonraki" AutomationProperties.Name="Sonraki parça"><c:IslandIcon Kind="Next" FontSize="11"/></Button>
                </StackPanel>
            </Grid>
            <ProgressBar Value="{Binding MediaProgress}" Maximum="100" Margin="0,10,0,0" Visibility="{Binding HasMedia, Converter={StaticResource BoolVisibility}}"/>
            <Grid Margin="0,4,0,0" Visibility="{Binding HasMedia, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding MediaPosition}" Style="{StaticResource Caption}" FontSize="9"/><TextBlock Text="{Binding MediaDuration}" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="9"/></Grid>
        </StackPanel>
    </Border>
</UserControl>
