<UserControl x:Class="NI.Views.Controls.NotificationsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:NI.Controls">
 <Border Style="{StaticResource GlassCard}" Padding="11,9">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <TextBlock Text="Bildirimler" FontSize="12" FontWeight="SemiBold" ToolTip="{Binding NotificationCountText}"/>
    <Button Grid.Column="1" Command="{Binding MarkReadCommand}" Style="{StaticResource IconButton}" Width="24" Height="24" MinHeight="24" ToolTip="Tümünü okundu işaretle" AutomationProperties.Name="Tümünü okundu işaretle"><c:IslandIcon Kind="Check" FontSize="12"/></Button>
   </Grid>
   <Grid Grid.Row="1">
    <StackPanel VerticalAlignment="Center" Margin="4" Visibility="{Binding HasNotifications, Converter={StaticResource NotVisibility}}">
     <c:IslandIcon Kind="Notification" FontSize="23" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12">
      <c:IslandIcon.Style><Style TargetType="c:IslandIcon"><Style.Triggers><DataTrigger Binding="{Binding HasTaskCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></c:IslandIcon.Style>
     </c:IslandIcon>
     <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="4,7,4,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasTaskCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding VisibleNotifications}" Visibility="{Binding HasNotifications, Converter={StaticResource BoolVisibility}}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
       HorizontalContentAlignment="Stretch" Background="{DynamicResource CardBrush}" Padding="8,5" Height="64" Margin="0,2" ToolTip="{Binding Body}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Top" Margin="0,4,0,0">
         <c:IslandIcon Kind="Notification" FontSize="16" Foreground="{DynamicResource TextMuted}"/>
         <Image Source="{Binding IconBytes, Converter={StaticResource ByteImage}}" Width="22" Height="22"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="7,0,5,0" VerticalAlignment="Center">
         <TextBlock Text="{Binding AppName}" FontSize="9" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1"/>
         <TextBlock Text="{Binding Body}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
         <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
         <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,6,0,0" HorizontalAlignment="Right" Visibility="{Binding IsRead, Converter={StaticResource NotVisibility}}"/>
        </StackPanel>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
   <Grid Grid.Row="2">
    <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectNotificationsCommand}" Margin="0,6,0,0" Visibility="{Binding NotificationsConnected, Converter={StaticResource NotVisibility}}"/>
    <Grid Visibility="{Binding HasNotificationPages, Converter={StaticResource BoolVisibility}}" Height="26" Margin="0,4,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
     <Button Command="{Binding PreviousNotificationPageCommand}" Style="{StaticResource IconButton}" Width="24" Height="24" MinHeight="24" AutomationProperties.Name="Önceki bildirim sayfası"><c:IslandIcon Kind="Previous" FontSize="10"/></Button>
     <TextBlock Grid.Column="1" Text="{Binding NotificationPageLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
     <Button Grid.Column="2" Command="{Binding NextNotificationPageCommand}" Style="{StaticResource IconButton}" Width="24" Height="24" MinHeight="24" AutomationProperties.Name="Sonraki bildirim sayfası"><c:IslandIcon Kind="Next" FontSize="10"/></Button>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</UserControl>
