<UserControl x:Class="NI.Views.IslandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NI.Controls"
             xmlns:panels="clr-namespace:NI.Views.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassStroke}"
            BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}">
        <Border Background="{StaticResource GlassSheen}" CornerRadius="{DynamicResource PanelRadius}">
            <StackPanel>
                <Grid Height="{Binding Appearance.CompactHeight}" Margin="12,0,9,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ClockText}" Typography.NumeralAlignment="Tabular" Visibility="{Binding Appearance.ShowClock, Converter={StaticResource BoolVisibility}}"
                               FontSize="14" FontWeight="SemiBold" Margin="5,0,14,0" AutomationProperties.Name="Saat"/>
                    <Button Grid.Column="1" Command="{Binding OpenPreviewCommand}" BorderBrush="Transparent" HorizontalContentAlignment="Stretch"
                            ToolTip="Bildirimi aç veya kontrol merkezini genişlet" Padding="4,0" AutomationProperties.Name="{Binding SummaryTitle}">
                        <Grid x:Name="SummaryContent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <c:IslandIcon Kind="{Binding SummaryIcon}" Foreground="{DynamicResource AccentBrush}"
                                          Visibility="{Binding HasPreviewIcon, Converter={StaticResource NotVisibility}}"/>
                            <Image Source="{Binding PreviewIcon, Converter={StaticResource ByteImage}}" Width="22" Height="22" Visibility="{Binding HasPreviewIcon, Converter={StaticResource BoolVisibility}}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,3,0">
                                <TextBlock Text="{Binding SummaryTitle}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding SummarySubtitle}" FontSize="10">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding ToggleSettingsCommand}" BorderBrush="Transparent" Padding="6,0"
                            Visibility="{Binding Appearance.ShowWeather, Converter={StaticResource BoolVisibility}}" ToolTip="Hava durumu • Open-Meteo">
                        <StackPanel Orientation="Horizontal"><c:IslandIcon Kind="Weather" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="{Binding WeatherText}" FontSize="11"/></StackPanel>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding ToggleAssistantCommand}" Style="{StaticResource IconButton}" ToolTip="Yerel ajan" AutomationProperties.Name="Yerel ajanı aç"><c:IslandIcon Kind="Assistant" FontSize="14"/></Button>
                    <Button Grid.Column="4" Command="{Binding ToggleExpandedCommand}" Style="{StaticResource IconButton}" ToolTip="Kontrol merkezi" AutomationProperties.Name="Kontrol merkezini aç veya kapat">
                        <c:IslandIcon Kind="Chevron" FontSize="12" RenderTransformOrigin=".5,.5">
                            <c:IslandIcon.Style><Style TargetType="c:IslandIcon"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></c:IslandIcon.Style>
                        </c:IslandIcon>
                    </Button>
                </Grid>
                <Grid x:Name="ExpandedBody" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <ContentControl x:Name="ExpandedPresenter" Content="{Binding}">
                        <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding BodyMaxHeight}" Padding="18,0,18,16">
                        <StackPanel>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8" Visibility="{Binding HasAlarmAlert, Converter={StaticResource BoolVisibility}}"><DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="10 dk ertele" Command="{Binding SnoozeAlarmCommand}" Margin="6,0"/><Button Content="Tamam" Command="{Binding DismissAlarmCommand}"/></StackPanel>
                                <TextBlock Text="{Binding AlarmAlert}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </DockPanel></Border>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding ToggleAssistantCommand}" Style="{StaticResource IconButton}" ToolTip="Yerel asistan" AutomationProperties.Name="Yerel Ollama asistanı" Visibility="{Binding AssistantEnabled, Converter={StaticResource BoolVisibility}}"><c:IslandIcon Kind="Assistant" FontSize="15"/></Button>
                                    <Button Command="{Binding ToggleSettingsCommand}" Style="{StaticResource IconButton}" ToolTip="Görünümü kişiselleştir" AutomationProperties.Name="Kişiselleştirme ayarları"><c:IslandIcon Kind="Settings" FontSize="15"/></Button>
                                </StackPanel>
                            </Grid>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style><Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><panels:DashboardPanel/></DataTemplate></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><panels:SettingsPanel/></DataTemplate></Setter.Value></Setter></DataTrigger>
                                        <DataTrigger Binding="{Binding IsAssistantOpen}" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><panels:AssistantPanel/></DataTemplate></Setter.Value></Setter></DataTrigger>
                                    </Style.Triggers>
                                </Style></ContentControl.Style>
                            </ContentControl>
                            <Border Style="{StaticResource GlassCard}" Margin="0,8,0,0" Padding="10,6" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
                                <DockPanel><Button DockPanel.Dock="Right" Command="{Binding DismissStatusCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Durum mesajını kapat"><c:IslandIcon Kind="Close" FontSize="10"/></Button><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{StaticResource Caption}"/></DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                            </DataTemplate></Setter.Value></Setter></DataTrigger>
                        </Style.Triggers></Style></ContentControl.Style>
                    </ContentControl>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
