<UserControl x:Class="NI.Views.IslandView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:NI.Controls" xmlns:panels="clr-namespace:NI.Views.Controls"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <c:GlassSurface x:Name="ShellSurface" Style="{StaticResource GlassPanel}">
  <Grid Background="{StaticResource GlassSheen}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Style="{StaticResource CompactBarContainer}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding ClockText}" Typography.NumeralAlignment="Tabular" FontSize="14" FontWeight="SemiBold" Margin="2,0,14,0"
     Visibility="{Binding Appearance.ShowClock, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Saat"/>
    <Grid Grid.Column="1">
     <Button x:Name="SummaryButton" Command="{Binding OpenPreviewCommand}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="2,0"
      Visibility="{Binding IsTaskInputOpen, Converter={StaticResource NotVisibility}}" ToolTip="{Binding SummaryTitle}" AutomationProperties.Name="{Binding SummaryTitle}">
      <Grid x:Name="SummaryContent">
       <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid>
        <c:IslandIcon Kind="{Binding SummaryIcon}" Foreground="{DynamicResource AccentBrush}">
         <c:IslandIcon.Style><Style TargetType="c:IslandIcon"><Style.Triggers>
          <DataTrigger Binding="{Binding HasPreviewIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          <DataTrigger Binding="{Binding ShowMediaBrand}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></c:IslandIcon.Style>
        </c:IslandIcon>
        <Image Source="{Binding PreviewIcon, Converter={StaticResource ByteImage}}" Width="22" Height="22" Visibility="{Binding HasPreviewIcon, Converter={StaticResource BoolVisibility}}"/>
        <c:MediaSourceIcon Source="{Binding MediaSource}" Visibility="{Binding ShowMediaBrand, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding MediaSourceName}"/>
       </Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,4,0">
        <TextBlock Text="{Binding SummaryTitle}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SummarySubtitle}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource TextSecondary}">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
       <c:MediaWaveform x:Name="CompactWaveform" Grid.Column="2" Margin="7,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
        IsPlaying="{Binding IsMediaPlaying}" ReduceMotion="{Binding Appearance.ReduceMotion}" Visibility="{Binding ShowCompactMedia, Converter={StaticResource BoolVisibility}}"/>
       <c:MediaWaveform Grid.Column="2" Margin="7,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
        IsPlaying="{Binding IsAssistantBusy}" ReduceMotion="{Binding Appearance.ReduceMotion}" Visibility="{Binding IsAssistantBusy, Converter={StaticResource BoolVisibility}}"/>
      </Grid>
     </Button>
     <Grid Visibility="{Binding IsTaskInputOpen, Converter={StaticResource BoolVisibility}}" Margin="0,5,5,5">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <TextBox x:Name="TaskInputBox" Style="{StaticResource InlineTaskInput}" Text="{Binding AssistantInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
       IsReadOnly="{Binding IsAssistantBusy}" AutomationProperties.Name="Yerel ajana görev yaz" ToolTip="Masaüstümü düzenle • Yarın 08:30 alarm kur • Sesi yüzde 20 yap">
       <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AskCommand}"/></TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Command="{Binding AskCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" ToolTip="Görevi çalıştır · Enter" AutomationProperties.Name="Görevi çalıştır"><c:IslandIcon Kind="Send" FontSize="14"/></Button>
     </Grid>
    </Grid>
    <Button Grid.Column="2" Command="{Binding ToggleSettingsCommand}" BorderThickness="0" Padding="5,0" Visibility="{Binding Appearance.ShowWeather, Converter={StaticResource BoolVisibility}}" ToolTip="Hava durumu ayarları">
     <TextBlock Text="{Binding WeatherText}" FontSize="11"/>
    </Button>
    <Button x:Name="AssistantButton" Grid.Column="3" Command="{Binding ToggleAssistantCommand}" Style="{StaticResource IconButton}" ToolTip="Görev yaz · Escape ile kapat" AutomationProperties.Name="Compact görev girişini aç"><c:IslandIcon Kind="Assistant" FontSize="16"/></Button>
    <Button x:Name="ExpandButton" Grid.Column="4" Command="{Binding ToggleExpandedCommand}" Style="{StaticResource IconButton}" ToolTip="Kontrol merkezi" AutomationProperties.Name="Kontrol merkezini aç veya kapat">
     <c:IslandIcon Kind="Chevron" FontSize="12" RenderTransformOrigin=".5,.5"><c:IslandIcon.Style><Style TargetType="c:IslandIcon"><Style.Triggers>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger>
     </Style.Triggers></Style></c:IslandIcon.Style></c:IslandIcon>
    </Button>
   </Grid>
   <Grid x:Name="ExpandedBody" Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}" Margin="16,0,16,14">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
     <ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="{StaticResource DashboardRowHeight}"/></Grid.RowDefinitions>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding HasStatus, Converter={StaticResource NotVisibility}}"/>
         <Grid Margin="0,0,4,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
          <Button Grid.Column="1" Command="{Binding DismissStatusCommand}" Style="{StaticResource IconButton}" Width="24" Height="22" MinHeight="22" AutomationProperties.Name="Durum mesajını kapat"><c:IslandIcon Kind="Close" FontSize="10"/></Button>
         </Grid>
         <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" HorizontalAlignment="Right" ToolTip="Görünüm ve ayarlar" AutomationProperties.Name="Ayarları aç"><c:IslandIcon Kind="Settings" FontSize="15"/></Button>
        </Grid>
        <ContentControl Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
         <ContentControl.Style><Style TargetType="ContentControl">
          <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><panels:DashboardPanel/></DataTemplate></Setter.Value></Setter>
          <Style.Triggers><DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><panels:SettingsPanel/></DataTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers>
         </Style></ContentControl.Style>
        </ContentControl>
       </Grid>
      </DataTemplate></Setter.Value></Setter></DataTrigger>
     </Style.Triggers></Style></ContentControl.Style>
    </ContentControl>
   </Grid>
  </Grid>
 </c:GlassSurface>
</UserControl>
