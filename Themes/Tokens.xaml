<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush po:Freeze="True" x:Key="TextPrimary" Color="#F0F4FA"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextSecondary" Color="#A4B1C4"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextMuted" Color="#8291A6"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentBrush" Color="#A8C7FA"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentSurface" Color="#243E6392"/>
    <SolidColorBrush po:Freeze="True" x:Key="SurfaceBrush" Color="#CC171F2D"/>
    <SolidColorBrush po:Freeze="True" x:Key="CardBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush po:Freeze="True" x:Key="InputSurface" Color="#182330"/>
    <SolidColorBrush po:Freeze="True" x:Key="HoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush po:Freeze="True" x:Key="StrokeBrush" Color="#16FFFFFF"/>
    <LinearGradientBrush po:Freeze="True" x:Key="GlassStroke" StartPoint="0,0" EndPoint=".75,1">
        <GradientStop Color="#50DDEBFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset=".5"/>
        <GradientStop Color="#22DDEBFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush po:Freeze="True" x:Key="GlassSheen" StartPoint="0,0" EndPoint=".8,1">
        <GradientStop Color="#0DDDEBFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset=".48"/>
    </LinearGradientBrush>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="PanelRadius">24</CornerRadius>
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <Thickness x:Key="PanelPadding">18,8,18,16</Thickness>
    <sys:Double x:Key="SpaceSmall">8</sys:Double>
    <sys:Double x:Key="SpaceMedium">12</sys:Double>
    <sys:Double x:Key="SpaceLarge">18</sys:Double>
</ResourceDictionary>
