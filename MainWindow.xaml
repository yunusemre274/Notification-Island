<Window x:Class="NI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NI.Views"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Notification Island" Width="{Binding PanelWidth}" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
 ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Topmost="{Binding Appearance.AlwaysOnTop}">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <views:IslandView x:Name="Island"/>
</Window>
